# Supabase project (client-side; the anon key is public by design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets ────────────────────────────────────────────
# None of the below are client variables. They live as Supabase Function
# secrets (supabase secrets set NAME=value) and never ship to the browser.
#
# GEMINI_API_KEY        the Gemini key. Required.
#
# DAILY_CALL_BUDGET     max Gemini calls per day, shared across both
#                       functions. Unset means no ceiling — the demo
#                       runs unmetered. Once set, a failing budget check
#                       refuses the call rather than silently allowing
#                       it, so the guard cannot fail open by accident.
#                       Reference: one upload costs 1 validation call
#                       plus 4 generation calls, so 250 is ~50 sittings.
#
# DEMO_ENABLED          set to "false" to close the demo immediately,
#                       independently of the counter. Anything else, or
#                       unset, leaves it open.
#
# VALIDATE_DEBUG        set to "true" to re-enable verbose validation
#                       logging. Off by default: those logs contained
#                       the model's analysis of a user's photo.
